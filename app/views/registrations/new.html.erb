<% content_for :title, "Create your account - USAN Event Liaison Tracker" %>

<div class="max-w-sm mx-auto px-6 py-16">
  <h1 class="text-xl font-semibold text-slate-900 mb-1">Create your account</h1>
  <p class="text-[13px] text-slate-500 mb-6">Set up your organization to start managing your own events and liaisons.</p>

  <%= form_with url: registration_path, class: "space-y-4" do %>
    <div>
      <%= label_tag "account[name]", "Organization name", class: form_label_class %>
      <%= text_field_tag "account[name]", @account.name, required: true, autofocus: true, class: form_field_class %>
    </div>
    <div>
      <%= label_tag "user[name]", "Your name", class: form_label_class %>
      <%= text_field_tag "user[name]", @user.name, required: true, class: form_field_class %>
    </div>
    <div>
      <%= label_tag "user[email_address]", "Email", class: form_label_class %>
      <%= email_field_tag "user[email_address]", @user.email_address, required: true, autocomplete: "username", class: form_field_class %>
    </div>
    <div>
      <%= label_tag "user[password]", "Password", class: form_label_class %>
      <%= password_field_tag "user[password]", nil, required: true, autocomplete: "new-password", maxlength: 72, class: form_field_class %>
    </div>

    <div class="pt-2 border-t border-slate-100">
      <p class="text-[13px] font-medium text-slate-700 mb-1">Home office</p>
      <p class="text-[12px] text-slate-500 mb-3">
        Where your map centers and every event's drive time is measured from. You can change this later in Settings.
      </p>
      <%= render "shared/location_picker",
            name_for: ->(field) { "account[office_#{field}]" },
            address: @account.office_address, city: @account.office_city, county: nil, show_county: false,
            state: @account.office_state, zip: @account.office_zip,
            latitude: @account.office_latitude, longitude: @account.office_longitude,
            address_placeholder: "4005 Port Chicago Hwy, Concord, CA 94520" %>
    </div>

    <%= submit_tag "Create account",
          class: "w-full bg-brand-700 hover:bg-brand-800 text-white text-[13px] font-semibold px-4 py-2.5 rounded-md cursor-pointer border-0" %>
  <% end %>

  <%= link_to "Already have an account? Sign in", new_session_path, class: "block text-center text-[12px] text-slate-500 hover:text-slate-700 mt-4" %>
</div>

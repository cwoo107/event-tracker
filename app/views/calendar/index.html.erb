<% content_for :title, "Calendar | USAN Event Liaison Tracker" %>

<div class="max-w-6xl mx-auto px-6 py-8">
  <div class="flex items-center justify-between mb-1">
    <div class="flex items-center gap-3">
      <%= link_to calendar_path(year: @calendar.previous_month.year, month: @calendar.previous_month.month),
            class: "w-8 h-8 flex items-center justify-center rounded-md border border-slate-200 text-slate-500 hover:bg-slate-50",
            aria: { label: "Previous month" } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      <% end %>
      <h1 class="text-xl font-semibold text-slate-900 w-48 text-center"><%= @calendar.label %></h1>
      <%= link_to calendar_path(year: @calendar.next_month.year, month: @calendar.next_month.month),
            class: "w-8 h-8 flex items-center justify-center rounded-md border border-slate-200 text-slate-500 hover:bg-slate-50",
            aria: { label: "Next month" } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      <% end %>
    </div>

    <div class="flex items-center gap-3 text-[12px] text-slate-500 flex-wrap justify-end">
      <% @liaisons.each do |liaison| %>
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full flex-none" style="background: <%= liaison.color %>"></span><%= liaison.name.split.first %>
        </div>
      <% end %>
    </div>
  </div>
  <p class="text-[13px] text-slate-500 mb-6">
    Week <%= @calendar.week_number_range %> of the <%= AssignmentSetting.for(Current.account).work_weeks_per_year %>-week calendar |
    <%= @calendar.filled_slots %> of <%= @calendar.total_slots %> weekly slots filled
  </p>

  <div style="display: grid; grid-template-columns: repeat(7, minmax(0, 1fr));"
       class="border border-slate-200 rounded-lg overflow-hidden bg-white">
    <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day| %>
      <div class="px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wide text-slate-400 border-b border-r border-slate-100 bg-slate-50">
        <%= day %>
      </div>
    <% end %>

    <% @calendar.weeks.each do |week| %>
      <% week.each do |cell| %>
        <div style="min-height: 96px;" class="p-1.5 border-b border-r border-slate-100 <%= 'bg-slate-50/60' unless cell.in_month %>">
          <p class="text-[11px] mb-1 <%= cell.in_month ? 'text-slate-500' : 'text-slate-300' %>"><%= cell.date.day %></p>
          <div class="space-y-1">
            <% cell.events.first(3).each do |event| %>
              <% liaison = event.liaisons.first %>
              <% style = marker_style(event) %>
              <%= link_to event_path(event), title: event.title,
                    class: "block text-[10px] leading-tight px-1.5 py-0.5 rounded truncate #{style.text_dark ? 'text-slate-700' : 'text-white'}",
                    style: "background: #{style.fill}; border: 1.5px solid #{style.border};" do %>
                <%= liaison ? "#{liaison.name.split.first} &mdash; #{event.city}".html_safe : event.city %>
              <% end %>
            <% end %>
            <% if cell.events.size > 3 %>
              <p class="text-[10px] text-slate-400">+<%= cell.events.size - 3 %> more</p>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<% if Current.user.admin? %>
  <div class="p-3 border-b border-slate-100">
    <%= link_to new_liaison_path,
          class: "flex items-center justify-center gap-1.5 w-full bg-lime-400 hover:bg-lime-500 text-brand-900 text-[13px] font-semibold px-3 py-2 rounded-md" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      New liaison
    <% end %>
  </div>
<% end %>

<div style="flex: 1 1 0%; overflow-y: auto;">
  <% @liaisons.each do |liaison| %>
    <%= link_to liaison_path(liaison),
          class: class_names(
            "block px-4 py-3 border-l-2 border-transparent hover:bg-slate-50",
            "bg-brand-50 border-l-brand-700" => liaison == @liaison
          ) do %>
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-[11px] font-semibold flex-none"
             style="background: <%= liaison.color %>">
          <%= liaison.initials %>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-[13px] font-medium text-slate-900 truncate"><%= liaison.name %></p>
        </div>
        <%= risk_badge(@risk_assessment.for(liaison)) %>
      </div>
    <% end %>
  <% end %>
</div>

<% content_for :title, "Liaisons | USAN Event Liaison Tracker" %>
<%= native_navbar_tag("Liaisons") %>

<div class="flex flex-col md:flex-row" style="height: calc(100vh - var(--app-header-height));">
  <aside class="flex flex-col w-full md:w-[300px] md:flex-none border-r border-slate-200 bg-white">
    <%= render "liaisons/sidebar" %>
  </aside>

  <main class="hidden md:flex flex-1 min-w-0 overflow-y-auto items-center justify-center text-slate-400 text-[13px]">
    Select a liaison from the sidebar to see their profile.
  </main>
</div>

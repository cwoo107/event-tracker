<% content_for :title, "Create a new account | USAN Event Liaison Tracker" %>

<div class="max-w-sm mx-auto px-6 py-16">
  <h1 class="text-xl font-semibold text-slate-900 mb-1">Create a new account</h1>
  <p class="text-[13px] text-slate-500 mb-6">
    You'll be an admin here, separate from your other accounts. You can switch between them anytime from the menu.
  </p>

  <%= form_with model: @account, url: accounts_path, class: "space-y-4" do |f| %>
    <% if @account.errors.any? %>
      <p class="text-[13px] text-rose-600"><%= @account.errors.full_messages.to_sentence %></p>
    <% end %>
    <div>
      <%= f.label :name, "Organization name", class: form_label_class %>
      <%= f.text_field :name, required: true, autofocus: true, class: form_field_class %>
    </div>

    <%= f.submit "Create account",
          class: "w-full bg-brand-700 hover:bg-brand-800 text-white text-[13px] font-semibold px-4 py-2.5 rounded-md cursor-pointer border-0" %>
  <% end %>

  <%= link_to "Cancel", root_path, class: "block text-center text-[12px] text-slate-500 hover:text-slate-700 mt-4" %>
</div>

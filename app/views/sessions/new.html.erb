<% content_for :title, "Sign in - USAN Event Liaison Tracker" %>

<div class="max-w-sm mx-auto px-6 py-10 sm:py-16">
  <h1 class="text-xl font-semibold text-slate-900 mb-1">Sign in</h1>
  <p class="text-[13px] text-slate-500 mb-6">Welcome back.</p>

  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-700 text-[13px] font-medium rounded-md" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-700 text-[13px] font-medium rounded-md" id="notice"><%= notice %></p>
  <% end %>

  <%= form_with url: session_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email_address, "Email", class: form_label_class %>
      <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address], class: form_field_class %>
    </div>
    <div>
      <%= f.label :password, class: form_label_class %>
      <%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
            class: form_field_class %>
    </div>
    <%= f.submit "Sign in",
          class: "w-full bg-brand-700 hover:bg-brand-800 text-white text-[13px] font-semibold px-4 py-2.5 rounded-md cursor-pointer border-0" %>
  <% end %>

  <%= link_to "Forgot password?", new_password_path, class: "block text-center text-[12px] text-slate-500 hover:text-slate-700 mt-4" %>
  <%= link_to "New organization? Create an account", new_registration_path, class: "block text-center text-[12px] text-slate-500 hover:text-slate-700 mt-2" %>
</div>

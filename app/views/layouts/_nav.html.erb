<div data-controller="dropdown">
<header class="h-16 flex items-center gap-3 md:gap-6 px-4 md:px-6 border-b border-slate-200 bg-white">
  <%= link_to map_path, class: "flex items-center gap-2.5 min-w-0" do %>
    <div class="flex items-center gap-1">
      <%= image_tag('811 Icon - Right.jpg', class: "w-16 md:w-[100px] h-auto") %>
    </div>
    <div class="h-8 w-px bg-slate-200 mx-1 hidden sm:block"></div>
    <div class="leading-tight text-left hidden sm:block min-w-0">
      <p class="text-sm font-semibold text-slate-900 truncate">Event tracker</p>
      <p class="text-[11px] text-slate-500 truncate"><%= Current.account.name %></p>
    </div>
  <% end %>

  <nav class="hidden md:flex items-center gap-1 text-[13px] font-medium text-slate-500">
    <%= link_to "Map", map_path,
          class: "px-3 py-2 rounded-md #{current_page?(map_path) ? 'bg-brand-50 text-brand-700' : 'hover:bg-slate-50 hover:text-slate-900'}" %>
    <%= link_to "Dashboard", dashboard_path,
          class: "px-3 py-2 rounded-md #{current_page?(dashboard_path) ? 'bg-brand-50 text-brand-700' : 'hover:bg-slate-50 hover:text-slate-900'}" %>
    <%= link_to "Calendar", calendar_path,
          class: "px-3 py-2 rounded-md #{current_page?(calendar_path) ? 'bg-brand-50 text-brand-700' : 'hover:bg-slate-50 hover:text-slate-900'}" %>
    <%= link_to "Requests", requests_path,
          class: "px-3 py-2 rounded-md #{current_page?(requests_path) ? 'bg-brand-50 text-brand-700' : 'hover:bg-slate-50 hover:text-slate-900'}" %>
    <%= link_to "Liaisons", liaisons_path,
          class: "px-3 py-2 rounded-md #{current_page?(liaisons_path) ? 'bg-brand-50 text-brand-700' : 'hover:bg-slate-50 hover:text-slate-900'}" %>
    <%= link_to "Assignment Settings", edit_settings_path,
          class: "px-3 py-2 rounded-md #{current_page?(edit_settings_path) ? 'bg-brand-50 text-brand-700' : 'hover:bg-slate-50 hover:text-slate-900'}" %>
  </nav>

  <div class="flex-1"></div>

  <%= link_to new_event_path, class: "hidden sm:flex items-center gap-1.5 bg-lime-400 hover:bg-lime-500 text-brand-900 text-[13px] font-semibold px-3.5 py-2 rounded-md shadow-sm shadow-lime-400/30" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
    New event request
  <% end %>

  <button type="button" data-action="click->dropdown#toggle" aria-label="Menu"
          class="md:hidden flex items-center justify-center w-9 h-9 -mr-1 rounded-md text-slate-500 hover:bg-slate-50 cursor-pointer border-0 bg-transparent">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>

  <div class="relative pl-3 border-l border-slate-200" data-controller="dropdown">
    <button type="button" data-action="click->dropdown#toggle"
            class="flex items-center gap-2.5 rounded-md p-1 -m-1 hover:bg-slate-50 cursor-pointer border-0 bg-transparent">
      <div class="w-8 h-8 rounded-full bg-brand-700 text-white text-[12px] font-semibold flex items-center justify-center flex-none">
        <%= Current.user.initials %>
      </div>
      <div class="leading-tight text-left hidden lg:block">
        <p class="text-[13px] font-medium text-slate-900"><%= Current.user.short_name %></p>
        <p class="text-[11px] text-slate-500"><%= Current.user.job_title %></p>
      </div>
    </button>

    <div data-dropdown-target="panel"
         class="hidden absolute right-0 top-full mt-1 w-52 bg-white border border-slate-200 rounded-md shadow-lg py-1 z-20">
      <% if Current.admin? %>
        <%= link_to "Account settings", account_users_path,
              class: "block px-3 py-2 text-[13px] text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <% other_accounts = Current.user.accounts.where.not(id: Current.account.id).order(:name) %>
      <div class="border-t border-slate-100 mt-1 pt-1">
        <% if other_accounts.any? %>
          <p class="px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-slate-400">Switch account</p>
          <% other_accounts.each do |account| %>
            <%= button_to account.name, account_switches_path(account_id: account.id), method: :post,
                  class: "w-full text-left px-3 py-2 text-[13px] text-slate-700 hover:bg-slate-50 bg-transparent border-0 cursor-pointer" %>
          <% end %>
        <% end %>
        <%= link_to "+ Create new account", new_account_path,
              class: "block px-3 py-2 text-[13px] text-slate-700 hover:bg-slate-50" %>
      </div>
      <div class="border-t border-slate-100 mt-1 pt-1">
        <%= button_to "Log out", session_path, method: :delete,
              class: "w-full text-left px-3 py-2 text-[13px] text-slate-700 hover:bg-slate-50 bg-transparent border-0 cursor-pointer" %>
      </div>
    </div>
  </div>
</header>

<div data-dropdown-target="panel" class="hidden md:hidden border-b border-slate-200 bg-white px-3 py-2 space-y-0.5 text-[13px] font-medium text-slate-500">
  <%= link_to "Map", map_path,
        class: "block px-3 py-2.5 rounded-md #{current_page?(map_path) ? 'bg-brand-50 text-brand-700' : 'hover:bg-slate-50 hover:text-slate-900'}" %>
  <%= link_to "Dashboard", dashboard_path,
        class: "block px-3 py-2.5 rounded-md #{current_page?(dashboard_path) ? 'bg-brand-50 text-brand-700' : 'hover:bg-slate-50 hover:text-slate-900'}" %>
  <%= link_to "Calendar", calendar_path,
        class: "block px-3 py-2.5 rounded-md #{current_page?(calendar_path) ? 'bg-brand-50 text-brand-700' : 'hover:bg-slate-50 hover:text-slate-900'}" %>
  <%= link_to "Requests", requests_path,
        class: "block px-3 py-2.5 rounded-md #{current_page?(requests_path) ? 'bg-brand-50 text-brand-700' : 'hover:bg-slate-50 hover:text-slate-900'}" %>
  <%= link_to "Liaisons", liaisons_path,
        class: "block px-3 py-2.5 rounded-md #{current_page?(liaisons_path) ? 'bg-brand-50 text-brand-700' : 'hover:bg-slate-50 hover:text-slate-900'}" %>
  <%= link_to "Assignment Settings", edit_settings_path,
        class: "block px-3 py-2.5 rounded-md #{current_page?(edit_settings_path) ? 'bg-brand-50 text-brand-700' : 'hover:bg-slate-50 hover:text-slate-900'}" %>
  <div class="pt-1 mt-1 border-t border-slate-100 sm:hidden">
    <%= link_to new_event_path, class: "flex items-center gap-1.5 justify-center bg-lime-400 hover:bg-lime-500 text-brand-900 text-[13px] font-semibold px-3.5 py-2.5 rounded-md" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      New event request
    <% end %>
  </div>
</div>
</div>

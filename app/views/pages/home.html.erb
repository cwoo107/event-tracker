 <% content_for :title, "Event Liaison Tracker - Match every event with the right liaison" %>

<div class="overflow-hidden">

  <%# ===== Hero ===== %>
  <div class="relative">
    <div class="absolute inset-2 bottom-0 rounded-4xl bg-linear-115 from-white from-20% via-brand-50 via-60% to-lime-100 sm:bg-linear-145 ring-1 ring-brand-900/5 ring-inset"></div>

    <div class="relative px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <header class="pt-6 sm:pt-8">
          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-2.5 min-w-0">
              <%= image_tag "811 Icon - Right.jpg", class: "w-14 sm:w-20 h-auto shrink-0", alt: "USAN" %>
              <div class="hidden sm:flex items-center gap-2.5 min-w-0">
                <div class="h-8 w-px bg-brand-900/10 shrink-0"></div>
                <div class="leading-tight min-w-0">
                  <p class="text-sm font-semibold text-slate-900 truncate">Event tracker</p>
                  <p class="text-[11px] text-slate-500 truncate">USAN Marketing &amp; Education</p>
                </div>
              </div>
            </div>

            <nav class="hidden lg:flex items-center gap-1 text-[13px] font-medium text-slate-600">
              <%= link_to "Features", "#features", class: "px-3 py-2 rounded-md hover:bg-white/60 hover:text-slate-900" %>
              <%= link_to "How it works", "#how-it-works", class: "px-3 py-2 rounded-md hover:bg-white/60 hover:text-slate-900" %>
            </nav>

            <div class="flex items-center gap-2 sm:gap-3 shrink-0">
              <%= link_to "Sign in", new_session_path, class: "hidden sm:inline text-[13px] font-medium text-slate-700 hover:text-slate-900 whitespace-nowrap" %>
              <%= link_to "Create an account", new_registration_path,
                    class: "bg-lime-400 hover:bg-lime-500 text-brand-900 text-[13px] font-semibold px-3 sm:px-3.5 py-2 rounded-md shadow-sm shadow-lime-400/30 whitespace-nowrap" %>
            </div>
          </div>
        </header>

        <div class="pt-20 pb-24 sm:pt-28 sm:pb-32">
          <p class="font-mono text-xs/5 font-semibold tracking-widest text-brand-700 uppercase">Event Liaison Tracker</p>
          <h1 class="mt-3 max-w-3xl text-5xl/[1.05] font-semibold tracking-tight text-balance text-slate-900 sm:text-6xl/[1.05]">
            Get the right liaison to every event.
          </h1>
          <p class="mt-6 max-w-xl text-lg/7 text-slate-600">
            Turn a community outreach request into a balanced field assignment — matched by
            region, drive time, and weekly workload, automatically.
          </p>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <%= link_to "Create an account", new_registration_path,
                  class: "inline-flex items-center justify-center bg-brand-700 hover:bg-brand-800 text-white text-sm font-semibold px-5 py-3 rounded-md shadow-sm" %>
            <%= link_to "Sign in", new_session_path,
                  class: "inline-flex items-center justify-center bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold px-5 py-3 rounded-md border border-slate-200" %>
          </div>
        </div>

      </div>
    </div>
  </div>

  <main>

    <%# ===== Capability strip ===== %>
    <div class="px-6 lg:px-8 py-14">
      <div class="mx-auto max-w-7xl grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-4">
        <div>
          <p class="text-2xl font-semibold text-slate-900">Live map</p>
          <p class="mt-1 text-[13px] text-slate-500">Every event and liaison, color-coded and plotted by region.</p>
        </div>
        <div>
          <p class="text-2xl font-semibold text-slate-900">Auto-assign</p>
          <p class="mt-1 text-[13px] text-slate-500">A weighted scoring engine ranks the best-fit liaison in one click.</p>
        </div>
        <div>
          <p class="text-2xl font-semibold text-slate-900">46-week calendar</p>
          <p class="mt-1 text-[13px] text-slate-500">Spot coverage gaps and overloaded weeks before they happen.</p>
        </div>
        <div>
          <p class="text-2xl font-semibold text-slate-900">Multi-tenant</p>
          <p class="mt-1 text-[13px] text-slate-500">Every organization manages its own liaisons, events, and settings.</p>
        </div>
      </div>
    </div>

    <div class="bg-linear-to-b from-white from-50% to-slate-100 py-28">

      <%# ===== Feature: map screenshot ===== %>
      <div id="features" class="overflow-hidden">
        <div class="px-6 lg:px-8 pb-24">
          <div class="mx-auto max-w-7xl">
            <p class="font-mono text-xs/5 font-semibold tracking-widest text-slate-500 uppercase">Map</p>
            <h2 class="mt-2 max-w-2xl text-4xl font-semibold tracking-tight text-balance text-slate-900 sm:text-5xl">
              See your whole event pipeline at a glance.
            </h2>
            <div class="mt-14 rounded-xl bg-white ring-1 ring-slate-950/10 shadow-xl overflow-hidden">
              <%= image_tag "marketing/Screenshot 2026-08-27 at 09-15-50 Map USAN Event Liaison Tracker.png",
                    class: "w-full h-auto", alt: "Map view of events, color-coded by assigned liaison" %>
            </div>
          </div>
        </div>
      </div>

      <%# ===== Bento grid ===== %>
      <div id="how-it-works" class="px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <p class="font-mono text-xs/5 font-semibold tracking-widest text-slate-500 uppercase">How it works</p>
          <h3 class="mt-2 max-w-2xl text-3xl font-semibold tracking-tight text-balance text-slate-900 sm:text-4xl">
            Everything a coordinator needs, in one place.
          </h3>

          <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 lg:grid-cols-6">

            <div class="lg:col-span-3 rounded-2xl bg-white ring-1 ring-slate-950/10 shadow-sm overflow-hidden">
              <div class="p-8">
                <p class="text-[13px] font-semibold text-brand-700">Dashboard</p>
                <h4 class="mt-1 text-xl font-semibold text-slate-900">Keep every liaison's workload balanced</h4>
                <p class="mt-2 text-[13px] text-slate-500">Track open requests, weekend load, drive hours, and burnout risk against your team's weekly target.</p>
              </div>
              <div class="h-56 overflow-hidden border-t border-slate-100">
                <%= image_tag "marketing/Screenshot 2026-08-27 at 09-16-03 Dashboard USAN Event Liaison Tracker.png",
                      class: "w-full h-auto object-cover object-top", alt: "Dashboard showing liaison load and balance" %>
              </div>
            </div>

            <div class="lg:col-span-3 rounded-2xl bg-white ring-1 ring-slate-950/10 shadow-sm overflow-hidden">
              <div class="p-8">
                <p class="text-[13px] font-semibold text-brand-700">Requests</p>
                <h4 class="mt-1 text-xl font-semibold text-slate-900">Turn a request into an assignment fast</h4>
                <p class="mt-2 text-[13px] text-slate-500">Log an event with its location, schedule, and requester in one form, then assign or auto-assign a liaison.</p>
              </div>
              <div class="h-56 overflow-hidden border-t border-slate-100">
                <%= image_tag "marketing/Screenshot 2026-08-27 at 09-18-06 New event request USAN Event Liaison Tracker.png",
                      class: "w-full h-auto object-cover object-top", alt: "New event request form" %>
              </div>
            </div>

            <div class="lg:col-span-2 rounded-2xl bg-white ring-1 ring-slate-950/10 shadow-sm overflow-hidden">
              <div class="p-6">
                <p class="text-[13px] font-semibold text-brand-700">Calendar</p>
                <h4 class="mt-1 text-lg font-semibold text-slate-900">A season-long view of coverage</h4>
              </div>
              <div class="h-40 overflow-hidden border-t border-slate-100">
                <%= image_tag "marketing/Screenshot 2026-08-27 at 09-16-20 Calendar USAN Event Liaison Tracker.png",
                      class: "w-full h-auto object-cover object-top", alt: "Calendar view of assigned events" %>
              </div>
            </div>

            <div class="lg:col-span-2 rounded-2xl bg-white ring-1 ring-slate-950/10 shadow-sm overflow-hidden">
              <div class="p-6">
                <p class="text-[13px] font-semibold text-brand-700">Assignment engine</p>
                <h4 class="mt-1 text-lg font-semibold text-slate-900">Tune what "best fit" means</h4>
              </div>
              <div class="h-40 overflow-hidden border-t border-slate-100">
                <%= image_tag "marketing/Screenshot 2026-08-27 at 09-16-38 Settings USAN Event Liaison Tracker.png",
                      class: "w-full h-auto object-cover object-top", alt: "Assignment engine weighting settings" %>
              </div>
            </div>

            <div class="lg:col-span-2 rounded-2xl bg-white ring-1 ring-slate-950/10 shadow-sm overflow-hidden">
              <div class="p-6">
                <p class="text-[13px] font-semibold text-brand-700">Accounts</p>
                <h4 class="mt-1 text-lg font-semibold text-slate-900">Every org keeps its own team</h4>
              </div>
              <div class="h-40 overflow-hidden border-t border-slate-100">
                <%= image_tag "marketing/Screenshot 2026-08-27 at 09-16-50 Account settings USAN Event Liaison Tracker.png",
                      class: "w-full h-auto object-cover object-top", alt: "Account settings and team management" %>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>

    <%# ===== Dark section: the assignment engine ===== %>
    <div class="mx-2 mt-2 rounded-4xl bg-brand-900 py-28">
      <div class="px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <p class="font-mono text-xs/5 font-semibold tracking-widest text-lime-400 uppercase">Under the hood</p>
          <h3 class="mt-2 max-w-2xl text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl">
            Built for teams that juggle a lot of ground to cover.
          </h3>

          <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 lg:grid-cols-3">
            <div class="rounded-2xl bg-white/5 ring-1 ring-white/10 p-8">
              <h4 class="text-lg font-semibold text-white">Weighted scoring</h4>
              <p class="mt-2 text-[13px] text-brand-100">
                Drive time, weekly load balance, weekend weighting, time of day, regional familiarity,
                and back-to-back travel are all scored and combined into one ranked list of candidates.
              </p>
            </div>
            <div class="rounded-2xl bg-white/5 ring-1 ring-white/10 p-8">
              <h4 class="text-lg font-semibold text-white">Hard rules</h4>
              <p class="mt-2 text-[13px] text-brand-100">
                Cap events per week, block long same-day round trips, require overnight approval,
                and enforce earliest-departure and latest-return times — automatically enforced on every assignment.
              </p>
            </div>
            <div class="rounded-2xl bg-white/5 ring-1 ring-white/10 p-8">
              <h4 class="text-lg font-semibold text-white">Burnout watch</h4>
              <p class="mt-2 text-[13px] text-brand-100">
                Liaisons trending over their weekly or weekend target are flagged on the dashboard
                before it becomes a problem, not after.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </main>

  <%# ===== Footer / CTA ===== %>
  <footer class="relative mt-2">
    <div class="absolute inset-2 rounded-4xl bg-linear-115 from-white from-20% via-brand-50 via-60% to-lime-100 sm:bg-linear-145 ring-1 ring-brand-900/5 ring-inset"></div>
    <div class="relative px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="relative py-20 text-center sm:py-24">
          <p class="font-mono text-xs/5 font-semibold tracking-widest text-brand-700 uppercase">Get started</p>
          <p class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
            Ready to get organized?
          </p>
          <p class="mx-auto mt-4 max-w-sm text-sm/6 text-slate-600">
            Create an account for your organization and start assigning events to your field team today.
          </p>
          <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <%= link_to "Create an account", new_registration_path,
                  class: "inline-flex items-center justify-center bg-brand-700 hover:bg-brand-800 text-white text-sm font-semibold px-5 py-3 rounded-md shadow-sm w-full sm:w-auto" %>
            <%= link_to "Sign in", new_session_path,
                  class: "inline-flex items-center justify-center bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold px-5 py-3 rounded-md border border-slate-200 w-full sm:w-auto" %>
          </div>
        </div>

        <div class="flex items-center justify-between border-t border-brand-900/10 py-6">
          <div class="flex items-center gap-2.5">
            <%= image_tag "811 Icon - Right.jpg", width: "60", height: "auto", alt: "USAN" %>
            <p class="text-[12px] text-slate-500">&copy; <%= Date.current.year %> USAN Event Liaison Tracker</p>
          </div>
          <%= link_to "Sign in", new_session_path, class: "text-[12px] font-medium text-slate-600 hover:text-slate-900" %>
        </div>

      </div>
    </div>
  </footer>

</div>

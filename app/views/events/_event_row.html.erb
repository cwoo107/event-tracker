<%
  liaison = event.liaisons.first
%>
<%= link_to event_path(event),
      data: { turbo_frame: "event_detail", event_id: event.id, action: "click->selection#select" },
      style: liaison ? "--liaison-color: #{liaison.color}" : nil,
      class: class_names(
        "sidebar-row block px-4 py-3 border-l-2 border-transparent hover:bg-slate-50",
        "is-active" => @selected_event == event
      ) do %>
  <div class="flex items-center justify-between gap-2">
    <p class="text-[13px] font-medium text-slate-900 truncate"><%= event.title %></p>
    <p class="text-[11px] text-slate-400 flex-none"><%= event.starts_at.strftime("%a, %b %-d") %></p>
  </div>
  <p class="text-[12px] text-slate-500 mt-0.5">
    <%= event.city %> &middot; <%= event.starts_at.strftime("%H:%M") %>&ndash;<%= event.ends_at.strftime("%H:%M") %>
    <% if event.drive_time_minutes %> &middot; <%= event.drive_time_minutes %>m drive<% end %>
  </p>
  <div class="flex items-center justify-between mt-1.5">
    <div class="flex gap-1.5 flex-wrap">
      <span class="text-[11px] font-medium text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded"><%= event.event_type.humanize %></span>
      <% if event.weekend? %>
        <span class="text-[11px] font-medium text-lime-700 bg-lime-100 px-1.5 py-0.5 rounded">Weekend &times;1.5</span>
      <% end %>
      <% if (event.drive_distance_miles || 0) >= 150 %>
        <span class="text-[11px] font-medium text-rose-700 bg-rose-50 px-1.5 py-0.5 rounded">Long haul</span>
      <% end %>
    </div>
    <% if liaison %>
      <% style = marker_style(event) %>
      <div class="flex items-center gap-1">
        <span class="w-2 h-2 rounded-full flex-none" style="background: <%= style.fill %>; border: 1.5px solid <%= style.border %>;"></span>
        <span class="text-[11px] font-medium text-slate-600"><%= liaison.name.split.first %></span>
      </div>
    <% end %>
  </div>
<% end %>

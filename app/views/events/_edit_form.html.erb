<div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
  <p class="text-[15px] font-semibold text-slate-900">Edit event</p>
  <%= link_to event_path(event), data: { turbo_frame: "event_detail" },
        class: "text-slate-400 hover:text-slate-600 text-lg leading-none", aria: { label: "Cancel" } do %>
    &times;
  <% end %>
</div>

<%= form_with model: event, url: event_path(event), method: :patch, data: { turbo_frame: "_top" }, class: "p-4 space-y-8" do |f| %>
  <% if event.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 px-4 py-3 text-[13px] text-rose-700">
      <p class="font-medium mb-1">Fix the following before saving:</p>
      <ul class="list-disc list-inside space-y-0.5">
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render "events/form_fields", f: f %>

  <section class="space-y-2">
    <h2 class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Materials &amp; equipment</h2>
    <div class="divide-y divide-slate-100 border border-slate-200 rounded-lg">
      <% Current.account.material_items.active.order(:name).each do |material| %>
        <% existing = event.event_material_items.find { |item| item.material_item_id == material.id } %>
        <div class="flex items-center gap-2 px-3 py-2">
          <%= check_box_tag "materials[#{material.id}][checked]", "1", existing&.checked? || false,
                class: "rounded border-slate-300 text-brand-600 focus:ring-brand-600/30" %>
          <span class="flex-1 text-[13px] text-slate-700"><%= material.name %></span>
          <%= number_field_tag "materials[#{material.id}][quantity]", existing&.quantity || 1, min: 0,
                class: "w-16 text-[12px] border border-slate-200 rounded px-1.5 py-1" %>
        </div>
      <% end %>
    </div>
  </section>

  <div class="flex items-center justify-end gap-3 pt-2 border-t border-slate-100">
    <%= link_to "Cancel", event_path(event), data: { turbo_frame: "event_detail" },
          class: "text-[13px] font-medium text-slate-500 hover:text-slate-700" %>
    <%= f.submit "Save changes",
          class: "bg-brand-700 hover:bg-brand-800 text-white text-[13px] font-semibold px-4 py-2.5 rounded-md cursor-pointer border-0" %>
  </div>
<% end %>

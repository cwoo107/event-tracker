<div class="p-4 border-b border-slate-100">
  <%= form_with url: map_path, method: :get, data: { turbo_frame: "sidebar_lists", controller: "auto-submit" }, class: "space-y-3" do |f| %>
    <%# carries the currently-open event forward so re-searching doesn't lose the sidebar's active-row highlight %>
    <%= f.hidden_field :event_id, value: params[:event_id] %>

    <div class="relative">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <%= f.text_field :q, value: params[:q], placeholder: "Search events, cities, requesters...",
            data: { action: "input->auto-submit#debouncedSubmit" },
            class: "w-full pl-9 pr-3 py-2 text-[13px] rounded-md border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 placeholder:text-slate-400" %>
    </div>

    <div class="flex flex-wrap gap-1.5">
      <% event_type_filter_options.each do |value, label| %>
        <% current = params[:type].presence || "all" %>
        <label class="px-2.5 py-1 rounded-full text-[12px] font-medium cursor-pointer <%= current == value ? 'bg-brand-700 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
          <%= f.radio_button :type, value, checked: current == value, class: "hidden", data: { action: "change->auto-submit#submit" } %>
          <%= label %>
        </label>
      <% end %>
    </div>
  <% end %>
</div>

<div class="flex-1 overflow-y-auto">
  <div class="px-4 pt-3 pb-1 flex items-center gap-2 sticky top-0 bg-white">
    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
    <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Unassigned</p>
    <span class="text-[11px] text-slate-400"><%= @unassigned_events.size %></span>
  </div>
  <% @unassigned_events.each do |event| %>
    <%= render "events/event_row", event: event %>
  <% end %>

  <div class="px-4 pt-4 pb-1 flex items-center gap-2 sticky top-0 bg-white">
    <span class="w-1.5 h-1.5 rounded-full bg-brand-600"></span>
    <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Assigned</p>
    <span class="text-[11px] text-slate-400"><%= @assigned_events.size %></span>
  </div>
  <% @assigned_events.each do |event| %>
    <%= render "events/event_row", event: event %>
  <% end %>

  <div class="px-4 pt-4 pb-1 flex items-center gap-2 sticky top-0 bg-white">
    <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
    <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Complete</p>
    <span class="text-[11px] text-slate-400"><%= @completed_events.size %></span>
  </div>
  <% @completed_events.each do |event| %>
    <%= render "events/event_row", event: event %>
  <% end %>
</div>

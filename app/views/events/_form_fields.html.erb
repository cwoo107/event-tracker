<section class="space-y-4">
  <h2 class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Event basics</h2>

  <div>
    <%= f.label :title, class: form_label_class %>
    <%= f.text_field :title, class: form_field_class, placeholder: "Sac Valley Ag Field Day" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :event_type_id, "Event type", class: form_label_class %>
      <%= f.select :event_type_id, Current.account.event_types.active.order(:name).pluck(:name, :id),
            { include_blank: "Select a type" }, class: form_field_class %>
    </div>
    <div>
      <%= f.label :estimated_attendees, "Expected attendees", class: form_label_class %>
      <%= f.number_field :estimated_attendees, class: form_field_class, min: 0 %>
    </div>
  </div>

  <div>
    <%= f.label :audience, class: form_label_class %>
    <%= f.text_field :audience, class: form_field_class, placeholder: "General public, contractors, students..." %>
  </div>
</section>

<section class="space-y-4">
  <h2 class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Schedule</h2>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :starts_at, "Starts", class: form_label_class %>
      <%= f.datetime_field :starts_at, class: form_field_class %>
    </div>
    <div>
      <%= f.label :ends_at, "Ends", class: form_label_class %>
      <%= f.datetime_field :ends_at, class: form_field_class %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :prep_minutes, "Prep (minutes)", class: form_label_class %>
      <%= f.number_field :prep_minutes, class: form_field_class, min: 0 %>
    </div>
    <div>
      <%= f.label :teardown_minutes, "Teardown (minutes)", class: form_label_class %>
      <%= f.number_field :teardown_minutes, class: form_field_class, min: 0 %>
    </div>
  </div>

  <label class="flex items-center gap-2 text-[13px] text-slate-700">
    <%= f.check_box :overnight_approved, class: "rounded border-slate-300 text-brand-600 focus:ring-brand-600/30" %>
    Overnight stay approved
  </label>
</section>

<section class="space-y-4">
  <h2 class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Location</h2>

  <%= render "shared/location_picker",
        name_for: ->(field) { "event[#{field}]" },
        address: f.object.address, city: f.object.city, county: f.object.county, show_county: true,
        state: f.object.state, zip: f.object.zip, latitude: f.object.latitude, longitude: f.object.longitude,
        address_placeholder: "550 Main St, Woodland, CA" %>

  <div>
    <%= f.label :venue_name, class: form_label_class %>
    <%= f.text_field :venue_name, class: form_field_class %>
  </div>
</section>

<section class="space-y-4">
  <h2 class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Requester</h2>
  <p class="text-[12px] text-slate-400 -mt-2">
    Optional - leave blank to default to you as the contact and your organization.
  </p>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :requester_organization, "Organization", class: form_label_class %>
      <%= f.text_field :requester_organization, class: form_field_class %>
    </div>
    <div>
      <%= f.label :requester_name, "Contact name", class: form_label_class %>
      <%= f.text_field :requester_name, class: form_field_class %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :requester_email, "Contact email", class: form_label_class %>
      <%= f.email_field :requester_email, class: form_field_class %>
    </div>
    <div>
      <%= f.label :requester_phone, "Contact phone", class: form_label_class %>
      <%= f.telephone_field :requester_phone, class: form_field_class %>
    </div>
  </div>
</section>
